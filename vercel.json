{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.hugoliveirapsicologo.com.br"
        }
      ],
      "destination": "https://hugoliveirapsicologo.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/publicacoes",
      "destination": "/publicacoes.html"
    },
    {
      "source": "/publicacoes/:slug([a-z0-9-]+)",
      "destination": "/publicacoes/:slug.html"
    },
    {
      "source": "/psicologo-em-castanhal",
      "destination": "/psicologo-em-castanhal.html"
    }
  ]
}
